# ==========================================
# CRUVELS WORKPLACE OS ENVIRONMENT CONFIG
# ==========================================

# Application Config
NEXT_PUBLIC_APP_NAME="Cruvels Workplace & Mail Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3005"
NODE_ENV="development"

# Authentication / JWT Session Key — generate with: openssl rand -base64 48
JWT_SECRET=""
SESSION_EXPIRY_HOURS="24"

# Required in production. Used by Vercel Cron and optional GitHub keep-alive.
CRON_SECRET=""

# Optional Web Push (generated automatically on first subscribe if omitted)
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# Supabase Database Configuration (required for production)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# DATA_BACKEND="supabase"  # default when the keys above are set
# DATA_BACKEND="memory"    # force JSON file store (tests / local only)

# Set this on Vercel when the Render mail worker is running (skip IMAP inside serverless)
EMAIL_SYNC_ON_READ="false"
MAIL_WORKER="1"

# Database URI (needed only to apply SQL from this repo; API keys cannot CREATE TABLE)
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# -------------------------------------------------------------
# EMAIL PROVIDER CONFIGURATION
# Mode options: "smtp_imap" | "mock" | "google_oauth" | "google_service_account"
# -------------------------------------------------------------
EMAIL_PROVIDER_MODE="smtp_imap"

# -------------------------------------------------------------
# MULTIPLE MAILBOXES CONFIGURATION (Configured for Cruvels SMTP/IMAP Accounts)
# Ingests from all mailboxes simultaneously and routes outgoing emails
# through the matching parent SMTP account based on the sender alias.
# -------------------------------------------------------------
MAILBOXES_CONFIG='[
  {
    "id": "eng_mailbox",
    "email": "engineering@cruvels.com",
    "smtpHost": "smtp.gmail.com",
    "smtpPort": 587,
    "smtpUser": "engineering@cruvels.com",
    "smtpPass": "your-app-password-1",
    "imapHost": "imap.gmail.com",
    "imapPort": 993,
    "imapUser": "engineering@cruvels.com",
    "imapPass": "your-app-password-1",
    "aliases": ["charith@cruvels.com", "niketh@cruvels.com", "pannagasai@cruvels.com", "rahul@cruvels.com", "priya@cruvels.com"]
  },
  {
    "id": "sales_mailbox",
    "email": "sales@cruvels.com",
    "smtpHost": "smtp.gmail.com",
    "smtpPort": 587,
    "smtpUser": "sales@cruvels.com",
    "smtpPass": "your-app-password-2",
    "imapHost": "imap.gmail.com",
    "imapPort": 993,
    "imapUser": "sales@cruvels.com",
    "imapPass": "your-app-password-2",
    "aliases": ["harshith@cruvels.com", "nitheesh@cruvels.com", "sales.intern@cruvels.com"]
  },
  {
    "id": "hr_mailbox",
    "email": "hr@cruvels.com",
    "smtpHost": "smtp.gmail.com",
    "smtpPort": 587,
    "smtpUser": "hr@cruvels.com",
    "smtpPass": "your-app-password-3",
    "imapHost": "imap.gmail.com",
    "imapPort": 993,
    "imapUser": "hr@cruvels.com",
    "imapPass": "your-app-password-3",
    "aliases": ["hr.intern@cruvels.com"]
  }
]'

# -------------------------------------------------------------
# SINGLE MAILBOX FALLBACK (Optional: if not using MAILBOXES_CONFIG)
# -------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="mail@cruvels.com"
SMTP_PASS="your-16-character-app-password"

IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER="mail@cruvels.com"
IMAP_PASS="your-16-character-app-password"

# Sync Worker Settings (Render background worker; 30s is Gmail-like)
SYNC_INTERVAL_SECONDS="30"
SYNC_BATCH_SIZE="50"
MAX_ATTACHMENT_SIZE_MB="25"

# Security & Rate Limiting
RATE_LIMIT_LOGIN_MAX="10"
RATE_LIMIT_LOGIN_WINDOW_SEC="60"
RATE_LIMIT_SEND_MAX="30"
RATE_LIMIT_SEND_WINDOW_SEC="3600"
